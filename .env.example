# ----------------------------------------------------------------------------
# Davos 2027 — Harvard Reception Volunteers
# Copy this file to ".env.local" and fill in the real values.
# NEVER commit .env.local — it is gitignored on purpose.
# ----------------------------------------------------------------------------

# Your Supabase project URL.
# Supabase Dashboard > Project Settings > Data API (or API) > "Project URL".
# Looks like: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The Supabase "anon" / publishable key (safe to expose in a browser).
# Supabase Dashboard > Project Settings > API Keys > "anon public".
# NOTE: this app never talks to Supabase from the browser, so this key is not
# strictly required for things to work — it is kept here for completeness and
# in case you later add browser-side, RLS-protected features.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Supabase "service_role" key — FULL ADMIN ACCESS, bypasses Row Level
# Security. KEEP THIS SECRET. It is only ever read on the server. Do NOT add a
# NEXT_PUBLIC_ prefix and do NOT paste it anywhere a browser can see it.
# Supabase Dashboard > Project Settings > API Keys > "service_role secret".
SUPABASE_SERVICE_ROLE_KEY=

# The single password that protects the admin dashboard. Choose something long
# and share it only with your co-organizers.
ADMIN_PASSWORD=
