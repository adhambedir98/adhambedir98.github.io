# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL is public; the service-role key is secret (server-side only).
# Get both from Supabase dashboard > Project Settings > API.
# The agent uses the SERVICE-ROLE key, which bypasses RLS. RLS is enabled on
# every table with no public policies, so only this server-side agent can touch
# the data.
SUPABASE_URL=https://zvotevxrebkqjncuyjlw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# ── Outreach sender ──────────────────────────────────────────────────────────
# Used for Gmail FOLLOW-UPS ONLY (replies / ongoing threads). It does NOT send
# cold first-touch — HBS relays first-touch from its own reputation.
OUTREACH_SENDER=adham@vound.ai
# Which sender identity to run as (see SENDERS in config.py). One for now.
ACTIVE_SENDER=Adham

# ── Volume / targeting ───────────────────────────────────────────────────────
DAILY_SEND_CAP=20      # max first-touch messages queued per day (current pace)
TARGET_SOURCE=HBS      # v1 is HBS only; MIT/Stanford added later

# ── Seed migration (one-time) ────────────────────────────────────────────────
# Local path to the seed file. data/ is gitignored (contains real contacts).
SEED_FILE=data/vound_contacts_seed.json

# ── Claude in Chrome handoff (Step 1 directory pull) ─────────────────────────
# Where Claude in Chrome deposits the directory read as a JSON list of profiles.
DIRECTORY_PULL_FILE=inbox/hbs_directory_pull.json

# ── Review dashboard output ──────────────────────────────────────────────────
REVIEW_DIR=review

# ── Gmail OAuth (Step 7 reply reading + Step 6 follow-up sending) ────────────
# OAuth client secret JSON (Google Cloud Console > Credentials > Desktop app).
GMAIL_CREDENTIALS_FILE=credentials/gmail_client_secret.json
# Token cache, created on first authorization. Per-sender (see config.SENDERS).
GMAIL_TOKEN_FILE=credentials/adham_token.json
